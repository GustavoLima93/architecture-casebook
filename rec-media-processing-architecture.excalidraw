    {
      "id": "subtitle",
      "type": "text",
      "x": 120,
      "y": 130,
      "width": 6000,
      "height": 70,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "groupIds": [],
      "frameId": null,
      "index": "a03j",
      "isDeleted": false,
      "link": null,
      "locked": false,
      "seed": 710015838,
      "version": 1,
      "versionNonce": 910209458,
      "updated": 1790506800000,
      "text": "Grupo Bandeirantes • Google News Initiative-selected project • ON-PREMISES\nContinuous live media → asynchronous, traceable and recoverable crop workflows",
      "originalText": "Grupo Bandeirantes • Google News Initiative-selected project • ON-PREMISES\nContinuous live media → asynchronous, traceable and recoverable crop workflows",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "boundElements": []
    },
    {
      "id": "text-central-thesis",
      "type": "text",
      "x": 152,
      "y": 310,
      "width": 6036,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "groupIds": [],
      "frameId": null,
      "index": "a03k",
      "isDeleted": false,
      "link": null,
      "locked": false,
      "seed": 710031676,
      "version": 1,
      "versionNonce": 910418916,
      "updated": 1790506800000,
      "text": "ARCHITECTURAL THESIS\nA crop was not a single HTTP request. It was a long-running distributed workflow involving filesystem I/O, native FFmpeg processes, RabbitMQ, Redis, SQL Server and external APIs — with ~200 crops in-flight on finite on-premises capacity.",
      "originalText": "ARCHITECTURAL THESIS\nA crop was not a single HTTP request. It was a long-running distributed workflow involving filesystem I/O, native FFmpeg processes, RabbitMQ, Redis, SQL Server and external APIs — with ~200 crops in-flight on finite on-premises capacity.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "central-thesis",
      "lineHeight": 1.25,
      "autoResize": true,
      "boundElements": []
    },
    {
      "id": "label-legend-zone",
