      "version": 1,
      "versionNonce": 923824228,
      "updated": 1790506800000,
      "text": "REDIS\nEphemeral Pipeline Recovery State\n\nKeyed / correlated by Crop UUID\n\nTemporary context for:\n• Intent\n• Join\n• Crop\n• recovery / reprocessing\n\nTTL: 3 DAYS\nAligned with availability of recovery-related media artifacts\n\nNot only a performance cache",
      "originalText": "REDIS\nEphemeral Pipeline Recovery State\n\nKeyed / correlated by Crop UUID\n\nTemporary context for:\n• Intent\n• Join\n• Crop\n• recovery / reprocessing\n\nTTL: 3 DAYS\nAligned with availability of recovery-related media artifacts\n\nNot only a performance cache",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "redis",
      "lineHeight": 1.25,
      "autoResize": true,
      "boundElements": []
    },
