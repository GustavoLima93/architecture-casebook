      "version": 1,
      "versionNonce": 910020007,
      "updated": 1790481600000,
      "text": "MONGODB\nDocument / payload workload\n\n• BPMN / XML\n• Automation documents\n• Execution input payload\n• Execution output payload",
      "originalText": "MONGODB\nDocument / payload workload\n\n• BPMN / XML\n• Automation documents\n• Execution input payload\n• Execution output payload",
