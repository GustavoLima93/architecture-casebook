    {
      "id": "text-workload-separation",
      "type": "text",
      "x": 2960,
      "y": 2248.5,
      "width": 1220,
      "height": 143,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "groupIds": [],
      "frameId": null,
      "index": "a037",
      "isDeleted": false,
      "link": null,
      "locked": false,
      "seed": 710017935,
      "version": 1,
      "versionNonce": 910020045,
      "updated": 1790481600000,
      "text": "ARCHITECTURAL EVOLUTION — SEPARATE WORKLOADS\n\nPostgreSQL → relational data / state / traceability\nMongoDB → BPMN/XML + large documents and execution payloads\n\nDecision based on different characteristics and access patterns — not simply “MongoDB is faster.”",
      "originalText": "ARCHITECTURAL EVOLUTION — SEPARATE WORKLOADS\n\nPostgreSQL → relational data / state / traceability\nMongoDB → BPMN/XML + large documents and execution payloads\n\nDecision based on different characteristics and access patterns — not simply “MongoDB is faster.”",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "workload-separation",
      "lineHeight": 1.25,
      "autoResize": true,
      "boundElements": []
    },
